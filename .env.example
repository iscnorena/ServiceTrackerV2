# Base de datos (Neon / Vercel Postgres en producción)
DATABASE_URL="postgresql://user:password@host:5432/servicetracker?schema=public"

# NextAuth
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional en desarrollo: si falta, el provider no se registra)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (modo test mientras el proyecto sea demo de portafolio — ver sección 7.1)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Resend (correo transaccional)
RESEND_API_KEY=""
EMAIL_FROM="ServiceTracker <no-reply@example.com>"

# Vercel Blob (fotos adjuntas y PDFs legales)
BLOB_READ_WRITE_TOKEN=""

# Cron de Vercel: protege los endpoints /api/cron/*
CRON_SECRET=""

# URL pública de la app (links de correo, QR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
